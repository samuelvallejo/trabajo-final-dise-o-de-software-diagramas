@startuml 04-vista-desarrollo
' EcoGestión – Vista de desarrollo: diagrama de clases por capas para el flujo de reportes
' (Spring Boot + Spring Data MongoDB)
skinparam dpi 120
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 40
skinparam ranksep 55
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #555555
  ArrowColor #333333
}
skinparam package {
  BorderColor #222222
  BorderThickness 1.4
  FontStyle bold
}
hide circle
skinparam packageStyle rectangle
skinparam roundCorner 6
<style>
package {
  HorizontalAlignment left
}
</style>
hide empty members
title EcoGestión — Diagrama de clases por capas (Controller → Service → Repository)

package "controller" #E8F0FE {
  class ReporteController <<RestController>> {
    - reporteService : ReporteService
    --
    + ReporteController(reporteService : ReporteService)
    + registrarReporte(cuenta : CuentaUsuario, request : ReporteRequest, fotos : List<MultipartFile>) : ResponseEntity<ReporteResponse>
    + asignarReporte(id : String, request : AsignacionRequest) : ResponseEntity<ReporteResponse>
    + listarReportes(cuenta : CuentaUsuario, estado : EstadoReporte, tipoResiduo : TipoResiduo, prioridad : Prioridad, sector : String) : ResponseEntity<List<ReporteResponse>>
    + obtenerReporte(cuenta : CuentaUsuario, id : String) : ResponseEntity<ReporteResponse>
  }
}

package "service" #EAF5EA {
  class ReporteService <<Service>> {
    - ciudadanoRepository : CiudadanoRepository
    - operadorRepository : OperadorRepository
    - reporteRepository : ReporteRepository
    - clasificacionService : ClasificacionService
    - notificacionService : NotificacionService
    - almacenamientoImagenes : AlmacenamientoImagenes
    --
    + ReporteService(ciudadanoRepository : CiudadanoRepository, operadorRepository : OperadorRepository, reporteRepository : ReporteRepository, ...)
    + registrarReporte(request : ReporteRequest, fotos : List<MultipartFile>, ciudadanoId : String) : ReporteResponse
    + asignarReporte(id : String, operadorId : String, reasignar : boolean) : ReporteResponse
    + listarReportes(usuarioId : String, rol : Rol, filtro : FiltroReportes) : List<ReporteResponse>
    + obtenerReporte(id : String, usuarioId : String, rol : Rol) : ReporteResponse
    - validarDisponibilidad(operador : Operador) : void
  }
}

package "repository" #FDF3E6 {
  interface ReporteRepository <<interface>> {
    .. extends MongoRepository<Reporte, String> ..
    + findById(id : String) : Optional<Reporte>
    + save(reporte : Reporte) : Reporte
    + findByEstado(estado : EstadoReporte) : List<Reporte>
    + findByCiudadanoOrderByFechaReporteDesc(ciudadano : Ciudadano) : List<Reporte>
    + countByOperadorAndEstadoNot(operador : Operador, estado : EstadoReporte) : long
    + buscarAbiertosCercanos(punto : GeoJsonPoint, metros : double, tipo : TipoResiduo) : List<Reporte>
  }
  interface CiudadanoRepository <<interface>> {
    .. extends MongoRepository<Ciudadano, String> ..
    + findById(id : String) : Optional<Ciudadano>
    + findByCorreo(correo : String) : Optional<Ciudadano>
  }
  interface OperadorRepository <<interface>> {
    .. extends MongoRepository<Operador, String> ..
    + findById(id : String) : Optional<Operador>
    + save(operador : Operador) : Operador
    + findByDisponibleTrueOrderByNombreAsc() : List<Operador>
  }
}

package "model" #FFFFFF {
  class Reporte <<Document>> {
    - id : String
    - descripcion : String
    - tipoResiduo : TipoResiduo
    - prioridad : Prioridad
    - latitud : double
    - longitud : double
    - direccion : String
    - sector : String
    - ubicacion : GeoJsonPoint
    - fotos : List<String>
    - fechaReporte : LocalDateTime
    - fechaResolucion : LocalDateTime [0..1]
    - estado : EstadoReporte
    - descripcionTrabajo : String [0..1]
    - fotosEvidencia : List<String>
    - ciudadano : Ciudadano
    - operador : Operador [0..1]
    - reporteOriginal : Reporte [0..1]
    - version : Long
    --
    + Reporte(fechaReporte : LocalDateTime, ciudadano : Ciudadano, descripcion : String)
    + registrarUbicacion(latitud : double, longitud : double, direccion : String, sector : String) : void
    + adjuntarFotos(urls : List<String>) : void
    + clasificar(tipo : TipoResiduo, prioridad : Prioridad) : void
    + asignar(operador : Operador) : void
    + reasignar(operador : Operador) : void
    + iniciarAtencion() : void
    + registrarCierre(descripcion : String, evidencias : List<String>) : void
    + marcarComoDuplicado(original : Reporte) : void
    + desvincularDuplicado() : void
    - cambiarEstado(nuevo : EstadoReporte) : void
    + getId() : String
    + getEstado() : EstadoReporte
    + estadoVisible() : EstadoReporte
    + estaPendiente() : boolean
    + getPrioridad() : Prioridad
    + getTipoResiduo() : TipoResiduo
    + getUbicacion() : GeoJsonPoint
    + getFechaReporte() : LocalDateTime
    + getFotos() : List<String> {readOnly}
    + getCiudadano() : Ciudadano
    + getOperador() : Operador
    + getReporteOriginalId() : String
  }
  abstract class Usuario {
    # id : String
    # nombre : String
    # documento : String
    # correo : String
    # contrasenaHash : String
    # intentosFallidos : int
    # bloqueadoHasta : LocalDateTime
    --
    + {abstract} getRol() : Rol
    + cambiarContrasena(actual : String, nueva : String, cifrador : PasswordEncoder) : void
    + estaBloqueado(ahora : LocalDateTime) : boolean
    + registrarIntentoFallido(ahora : LocalDateTime, maximo : int, minutos : int) : void
    + tieneIntentosFallidos() : boolean
    + reiniciarIntentos() : void
    # actualizarNombreYCorreo(nombre : String, correo : String) : void
    + getId() : String
    + getNombre() : String
    + getDocumento() : String
    + getCorreo() : String
    + getContrasenaHash() : String {solo Spring Security}
  }
  class Ciudadano <<Document>> {
    - sector : String
    --
    + Ciudadano(nombre : String, documento : String, correo : String, contrasenaHash : String, sector : String)
    + getRol() : Rol
    + actualizarPerfil(nombre : String, correo : String, sector : String) : void
    + getSector() : String
  }
  class Operador <<Document>> {
    - disponible : boolean
    --
    + Operador(nombre : String, documento : String, correo : String, contrasenaHash : String)
    + getRol() : Rol
    + marcarOcupado() : void
    + marcarDisponible() : void
    + isDisponible() : boolean
  }
  note as Encapsulamiento
    <b>Encapsulamiento</b>
    Las clases del modelo no tienen setters.
    Spring Data guarda y lee los atributos por
    reflexión, así que no los necesita. Cada cambio
    pasa por un método que valida la regla (asignar,
    registrarCierre, actualizarPerfil, cambiarContrasena).
    Los get existen para armar los DTO de respuesta;
    las listas se devuelven inmodificables.
  end note
}

ReporteController --> "1" ReporteService
ReporteService --> "1" ReporteRepository
ReporteService --> "1" CiudadanoRepository
ReporteService --> "1" OperadorRepository
ReporteService ..> Reporte : <<create>>
ReporteRepository ..> Reporte : <<use>>
CiudadanoRepository ..> Ciudadano : <<use>>
OperadorRepository ..> Operador : <<use>>
Usuario <|-- Ciudadano
Usuario <|-- Operador
Reporte "0..*" --> "1" Ciudadano : historial
Reporte "0..*" --> "0..1" Operador : atiende
Reporte "0..*" --> "0..1" Reporte : duplicadoDe
@enduml
