@startuml 03-vista-logica
' EcoGestión – Vista lógica: modelo de clases inicial
' Persistencia en MongoDB: los id son ObjectId (String).
skinparam dpi 120
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 60
skinparam ranksep 60
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #555555
  ArrowColor #333333
}
hide circle
hide empty members
title EcoGestión — Modelo de clases inicial

class GestorReportes {
  - ciudadanos : List<Ciudadano>
  - operadores : List<Operador>
  - reportes : List<Reporte>
  --
  + GestorReportes()
  + registrarCiudadano(c : Ciudadano) : void
  + registrarOperador(o : Operador) : void
  + registrarReporte(c : Ciudadano, descripcion : String) : Reporte
  + asignarReporte(r : Reporte, o : Operador) : void
  + consultarReportes() : List<Reporte>
  + consultarOperadoresDisponibles() : List<Operador>
}

class Ciudadano {
  - id : String
  - nombre : String
  - documento : String
  - correo : String
  - contrasenaHash : String
  - sector : String
  --
  + Ciudadano(nombre : String, documento : String, correo : String, contrasenaHash : String, sector : String)
  + actualizarPerfil(nombre : String, correo : String, sector : String) : void
  + cambiarContrasena(actual : String, nueva : String) : void
  + getId() : String
  + getNombre() : String
  + getCorreo() : String
  + getSector() : String
}

class Operador {
  - id : String
  - nombre : String
  - disponible : boolean
  --
  + Operador(nombre : String)
  + marcarOcupado() : void
  + marcarDisponible() : void
  + getId() : String
  + getNombre() : String
  + isDisponible() : boolean
}

class Reporte {
  - id : String
  - descripcion : String
  - tipoResiduo : TipoResiduo
  - prioridad : Prioridad
  - latitud : double
  - longitud : double
  - direccion : String
  - sector : String
  - fotos : List<String>
  - fechaReporte : LocalDateTime
  - fechaResolucion : LocalDateTime [0..1]
  - estado : EstadoReporte
  - descripcionTrabajo : String [0..1]
  - fotosEvidencia : List<String>
  - ciudadano : Ciudadano
  - operador : Operador [0..1]
  - reporteOriginal : Reporte [0..1]
  --
  + Reporte(fecha : LocalDateTime, ciudadano : Ciudadano, descripcion : String)
  + registrarUbicacion(latitud : double, longitud : double, direccion : String, sector : String) : void
  + adjuntarFotos(urls : List<String>) : void
  + clasificar(tipo : TipoResiduo, prioridad : Prioridad) : void
  + asignar(operador : Operador) : void
  + iniciarAtencion() : void
  + registrarCierre(descripcion : String, evidencias : List<String>) : void
  + marcarComoDuplicado(original : Reporte) : void
  - cambiarEstado(nuevo : EstadoReporte) : void
  + getId() : String
  + getDescripcion() : String
  + getEstado() : EstadoReporte
  + estadoVisible() : EstadoReporte
  + getPrioridad() : Prioridad
  + getFechaReporte() : LocalDateTime
  + getFotos() : List<String> {readOnly}
}

note as Encapsulamiento
  <b>Encapsulamiento</b>
  No hay métodos set: los atributos solo cambian con
  métodos que validan las reglas del caso de estudio
  (p. ej. <i>asignar()</i> impide dos operadores y
  <i>cambiarEstado()</i> es privado para no saltar estados).
  Los get son de solo lectura y existen para mostrar
  datos; las listas se devuelven inmodificables.
end note

GestorReportes "1" -- "0..*" Ciudadano : registra
GestorReportes "1" -- "0..*" Operador : administra
GestorReportes "1" -- "0..*" Reporte : gestiona
Ciudadano "1" -- "0..*" Reporte : historial
Operador "0..1" -- "0..*" Reporte : atiende
Reporte "0..*" -- "0..1" Reporte : duplicadoDe
@enduml
