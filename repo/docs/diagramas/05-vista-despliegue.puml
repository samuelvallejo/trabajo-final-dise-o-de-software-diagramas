@startuml 05-vista-despliegue
' EcoGestión – Vista de despliegue (diagrama de despliegue UML)
skinparam dpi 110
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam nodesep 50
skinparam ranksep 110
skinparam node {
  BackgroundColor #FFFFFF
  BorderColor #333333
  BorderThickness 1.6
  FontStyle bold
}
skinparam artifact {
  BackgroundColor #E8F5E9
  BorderColor #1B5E20
  FontStyle bold
}
skinparam ArrowColor #222222
skinparam ArrowThickness 1.4

' ---------------- Clientes ----------------
node ":Smartphone del ciudadano" <<device>> as DCiu {
  node ":Android / iOS" <<executionEnvironment>> as EECiu {
    artifact "ecogestion-movil\n(React Native)" <<artifact>> as AMovCiu
  }
  node ":Sensor GPS" <<device>> as GPS
}

node ":PC del ciudadano / administrador" <<device>> as DPc {
  node ":Navegador web" <<executionEnvironment>> as EENav {
    artifact "ecogestion-web\n(React SPA)" <<artifact>> as AWebCli
  }
}

node ":Smartphone del operador" <<device>> as DOpe {
  node ":Android / iOS" <<executionEnvironment>> as EEOpe {
    artifact "ecogestion-movil\n(modo operador)" <<artifact>> as AMovOpe
  }
}

' ---------------- Servidor de aplicación ----------------
node ":Servidor web/API\n(Linux · nube)" <<device>> as DSrv {
  node ":Nginx" <<executionEnvironment>> as EENginx {
    artifact "ecogestion-web\n(archivos estáticos)" <<artifact>> as AWebSrv
  }
  node ":JVM 21 · Spring Boot" <<executionEnvironment>> as EEJvm {
    artifact "ecogestion-api.jar" <<artifact>> as AApi
  }
}

' ---------------- Datos y servicios externos ----------------
node ":Servidor de base de datos" <<device>> as DBd {
  node ":PostgreSQL 16 + PostGIS" <<executionEnvironment>> as EEPg {
    artifact "ecogestion_db" <<artifact>> as ABd
  }
}

node ":Almacenamiento de imágenes\n(Amazon S3)" <<device>> as DS3 {
  artifact "bucket\necogestion-fotos" <<artifact>> as AS3
}

node ":Servicio de correo electrónico\n(servidor SMTP)" <<device>> as DSmtp {
  artifact "relay SMTP" <<artifact>> as ASmtp
}

node ":Servicio de mapas/GPS\n(Google Maps Platform)" <<device>> as DMap {
  artifact "Maps SDK +\nGeocoding API" <<artifact>> as AMap
}

' ---------------- Conexiones ----------------
DCiu -- DSrv : HTTPS:443\n(REST/JSON)
DPc -- DSrv : HTTPS:443
DOpe -- DSrv : HTTPS:443\n(REST/JSON)
DSrv -- DBd : JDBC/TCP:5432
DSrv -- DS3 : HTTPS:443\n(SDK S3)
DSrv -- DSmtp : SMTP/TLS:587
DSrv -- DMap : HTTPS:443\n(Geocoding)
@enduml
