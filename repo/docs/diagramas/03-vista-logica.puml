@startuml 03-vista-logica
' EcoGestión – Vista lógica (diagrama de clases UML del dominio)
skinparam dpi 110
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 45
skinparam ranksep 70
skinparam class {
  BackgroundColor #DCEDC8
  BorderColor #33691E
  BorderThickness 1.4
  ArrowColor #333333
  HeaderBackgroundColor #AED581
}
skinparam enum {
  BackgroundColor #FFF9C4
  BorderColor #827717
}
skinparam interface {
  BackgroundColor #E1F5FE
  BorderColor #01579B
}
hide empty members

' ===================== Usuarios =====================
abstract class Usuario {
  - id: Long
  - nombre: String
  - documentoIdentidad: String
  - correo: String
  - contrasenaHash: String
  - fechaRegistro: LocalDateTime
  + iniciarSesion(correo, contrasena): boolean
  + actualizarDatos(nombre, correo): void
  + cambiarContrasena(actual, nueva): void
}

class Ciudadano {
  - telefono: String
  + crearReporte(datos): Reporte
  + consultarMisReportes(): List<Reporte>
}

class Administrador {
  - cargo: String
  + clasificarReporte(r, tipo, prioridad): void
  + vincularDuplicado(r, original): void
  + asignarReporte(r, operador): Asignacion
  + generarInforme(desde, hasta): Informe
}

class Operador {
  - equipo: String
  - disponible: boolean
  + consultarAsignados(): List<Asignacion>
  + actualizarEstado(r, estado): void
  + registrarAtencion(desc, evidencias): void
}

Usuario <|-- Ciudadano
Usuario <|-- Administrador
Usuario <|-- Operador

' ===================== Reportes =====================
class Reporte {
  - id: Long
  - descripcion: String
  - fechaCreacion: LocalDateTime
  - estado: EstadoReporte
  - prioridad: Prioridad
  + cambiarEstado(nuevo: EstadoReporte): void
  + marcarComoDuplicado(original: Reporte): void
  + esDuplicado(): boolean
}

class TipoResiduo {
  - id: Long
  - nombre: String
  - esPeligroso: boolean
  - prioridadSugerida: Prioridad
}

enum Prioridad <<enumeration>> {
  Alta
  Media
  Baja
}

enum EstadoReporte <<enumeration>> {
  Pendiente
  Asignado
  EnProceso
  Resuelto
}

class Ubicacion {
  - latitud: double
  - longitud: double
  - direccion: String
  - origen: OrigenUbicacion
}

enum OrigenUbicacion <<enumeration>> {
  GPS
  Mapa
}

class Fotografia {
  - id: Long
  - url: String
  - fechaCarga: LocalDateTime
}

class Evidencia {
  - descripcion: String
}

Fotografia <|-- Evidencia

Ciudadano "1" -- "0..*" Reporte : crea >
Reporte "0..*" --> "1" TipoResiduo : clasificado como >
Reporte "0..*" ..> Prioridad
Reporte ..> EstadoReporte
Reporte "1" *-- "1" Ubicacion : se ubica en >
Ubicacion ..> OrigenUbicacion
Reporte "1" *-- "1..5" Fotografia : adjunta >
Reporte "0..*" --> "0..1" Reporte : duplicadoDe >
Reporte "0..*" --> "1" Sector : ocurre en >

' ===================== Asignación y atención =====================
class Asignacion {
  - id: Long
  - fechaAsignacion: LocalDateTime
  - activa: boolean
  + finalizar(): void
}

class AtencionLimpieza {
  - id: Long
  - fechaInicio: LocalDateTime
  - fechaFin: LocalDateTime
  - descripcionTrabajo: String
  + registrarCierre(desc, evidencias): void
}

Reporte "1" -- "0..*" Asignacion : tiene >
Administrador "1" -- "0..*" Asignacion : realiza >
Asignacion "0..*" -- "1" Operador : asignada a >
Asignacion "1" *-- "0..1" AtencionLimpieza : registra >
AtencionLimpieza "1" *-- "0..*" Evidencia : documenta >

' ===================== Notificaciones =====================
class Notificacion {
  - id: Long
  - asunto: String
  - mensaje: String
  - fechaEnvio: LocalDateTime
  - enviada: boolean
  + enviar(canal: CanalNotificacion): void
}

interface CanalNotificacion <<interface>> {
  + enviar(n: Notificacion, destino: Usuario): boolean
}

class CanalCorreo {
  - servidorSmtp: String
  + enviar(n: Notificacion, destino: Usuario): boolean
}

CanalNotificacion <|.. CanalCorreo
Notificacion "0..*" --> "1" Usuario : dirigida a >
Notificacion "0..*" --> "1" Reporte : informa sobre >
Notificacion ..> CanalNotificacion : usa >

' ===================== Recolección =====================
class Sector {
  - id: Long
  - nombre: String
  - comuna: String
  + consultarHorarios(): List<HorarioRecoleccion>
}

class Barrio {
  - id: Long
  - nombre: String
}

class RutaRecoleccion {
  - id: Long
  - nombre: String
  - recorrido: String
  + actualizar(datos): void
}

class HorarioRecoleccion {
  - diaSemana: DayOfWeek
  - horaInicio: LocalTime
  - horaFin: LocalTime
}

class PuntoRecoleccion {
  - id: Long
  - nombre: String
  - horarioAtencion: String
  + recibeMaterial(m: MaterialAceptado): boolean
}

class MaterialAceptado {
  - id: Long
  - nombre: String
  - categoria: String
}

Sector "1" o-- "1..*" Barrio : agrupa >
Ciudadano "0..*" --> "0..1" Barrio : reside en >
RutaRecoleccion "1..*" -- "1..*" Sector : cubre >
RutaRecoleccion "1" *-- "1..*" HorarioRecoleccion : programa >
PuntoRecoleccion "1" *-- "1" Ubicacion : se ubica en >
PuntoRecoleccion "0..*" o-- "1..*" MaterialAceptado : recibe >

' ===================== Educación y estadísticas =====================
class ContenidoEducativo {
  - id: Long
  - titulo: String
  - cuerpo: String
  - categoria: String
  - fechaPublicacion: LocalDate
  + publicar(): void
  + actualizar(datos): void
}

class Informe {
  - id: Long
  - periodoInicio: LocalDate
  - periodoFin: LocalDate
  - totalReportes: int
  - pendientes: int
  - resueltos: int
  + problemasFrecuentes(): Map<TipoResiduo, Integer>
  + sectoresMayorAcumulacion(): List<Sector>
}

Administrador "1" -- "0..*" ContenidoEducativo : publica >
Administrador "1" -- "0..*" Informe : genera >
Informe "0..*" o-- "0..*" Reporte : resume >
@enduml
