@startuml 02-vista-funcional
' EcoGestión – Vista funcional (diagrama de componentes UML)
' Notación: «component», interfaz provista = círculo (lollipop),
' interfaz requerida = semicírculo (socket), puertos = cuadros en el borde.
skinparam componentStyle uml2
skinparam dpi 110
skinparam defaultFontName Arial
skinparam defaultFontSize 14
skinparam shadowing false
skinparam nodesep 70
skinparam ranksep 80
skinparam component {
  BackgroundColor #FFF2CC
  BorderColor #333333
  BorderThickness 1.5
  FontStyle bold
}
skinparam interface {
  BackgroundColor #FFFFFF
  BorderColor #333333
}
skinparam package {
  BorderColor #1B5E20
  FontColor #1B5E20
}
skinparam note {
  BackgroundColor #F5F5F5
  BorderColor #999999
}

package "EcoGestión – API REST (Spring Boot)" {

  component "Gestión de usuarios" <<component>> as CUsu
  component "Gestión de reportes" <<component>> as CRep {
    portin "pReportes" as pRep
  }
  component "Clasificación y priorización" <<component>> as CCla
  component "Asignación y atención" <<component>> as CAsi {
    portin "pOperador" as pAsi
  }
  component "Notificaciones" <<component>> as CNot {
    portout "pCanal" as pCanal
  }
  component "Horarios y rutas" <<component>> as CHor
  component "Puntos de recolección" <<component>> as CPun
  component "Contenido educativo" <<component>> as CEdu
  component "Estadísticas e informes" <<component>> as CEst

  component "Canal correo" <<component>> as CCorreo
  component "Canal SMS (futuro)" <<component>> as CSms #FFFFFF
  component "Canal push (futuro)" <<component>> as CPush #FFFFFF

  component "Integración de mapas" <<component>> as CMap
  component "Almacenamiento de imágenes" <<component>> as CAlm

' ---------- Interfaces (declaradas dentro del sistema) ----------
  interface "IAsignacion" as IAsi
  interface "IEstadisticas" as IEst
  interface "IContenidoEducativo" as IEdu
  interface "IHorariosRutas" as IHor
  interface "IPuntosRecoleccion" as IPun
  interface "IReportes" as IRep
  interface "IUsuarios" as IUsu
  interface "INotificaciones" as INot
  interface "IAutenticacion" as IAut
  interface "IClasificacion" as ICla
  interface "IMapas" as IMap
  interface "IAlmacenamientoImagenes" as IAlm
  interface "ICanalNotificacion" as ICanal
}

' ---------- Interfaces provistas (lollipop) ----------
IAsi -- pAsi
IEst -- CEst
IEdu -- CEdu
IHor -- CHor
IPun -- CPun
IRep -- pRep
IUsu -- CUsu
INot -- CNot
CUsu -- IAut
ICla -- CCla
IMap -- CMap
IAlm -- CAlm

' ---------- Interfaces requeridas (socket) ----------
CAsi --( IRep
CAsi --( IUsu
CAsi --( INot
CAsi ---( IAlm
CEst --( IRep
CRep --( IAut
CRep --( ICla
CRep --( IMap
CRep --( IAlm
CHor --( IMap
CPun --( IMap
pCanal --( ICanal

' ---------- Canales de notificación (extensible) ----------
ICanal -- CCorreo
ICanal .. CSms
ICanal .. CPush

note bottom of CCorreo
  Patrón Estrategia: nuevos canales
  (SMS, push) implementan
  ICanalNotificacion sin modificar
  el componente Notificaciones.
end note
@enduml
